.Background {
    background-color: rgb(0, 0, 0);
    width: 80%;
    height: 30%;
    max-height: 25%;
    align-self: center;
    bottom: auto;
    top: 70%;
    flex-direction: row;
}

.NPC_Icon {
    height: 100%;
    width: 20%;
}

.Text {
    width: 80%;
    font-size: 25px;
    -unity-text-align: upper-left;
    white-space: normal;
    text-overflow: ellipsis;
}

.ButtonsBorder {
    flex-grow: 1;
    position: relative;
    bottom: auto;
    width: 60%;
    max-height: 6%;
    right: auto;
    left: 28%;
    top: 66%;
    background-color: rgba(0, 0, 0, 0);
    flex-direction: row;
    justify-content: space-evenly;
    align-items: stretch;
}

.AnswerButton {
    width: 30%;
    font-size: 25px;
}

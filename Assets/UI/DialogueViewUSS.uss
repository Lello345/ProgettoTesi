.Background {
    background-color: rgb(0, 0, 0);
    width: 80%;
    height: 30%;
    max-height: 25%;
    align-self: center;
    bottom: auto;
    top: 60%;
    flex-direction: row;
}

.NPC_Icon {
    height: 100%;
    width: 20%;
}

.Text {
    width: 80%;
    font-size: 15px;
    -unity-text-align: upper-left;
    white-space: normal;
    text-overflow: ellipsis;
    color: rgb(255, 255, 255);
}

.ButtonsBorder {
    flex-grow: 1;
    position: relative;
    bottom: auto;
    width: 62%;
    max-height: 16%;
    right: auto;
    left: 26%;
    top: 52%;
    flex-direction: row;
    align-items: center;
    justify-content: space-around;
    flex-wrap: wrap;
}

.AnswerButton {
    font-size: 15px;
    color: rgb(0, 0, 0);
    -unity-text-align: middle-left;
    flex-wrap: wrap;
    align-self: center;
    width: 30%;
    height: auto;
    white-space: normal;
}
